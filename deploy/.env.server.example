# Settings for deploy/docker-compose.server.yml (Dokploy / Traefik). In Dokploy paste them into the
# compose service's Environment tab; by hand, copy to deploy/.env.server and pass --env-file.
# Every variable is required: compose stops and names the first one that is missing or empty.
# Write a literal "$" as "$$".

# ---------------------------------------------------------------------------
# Proxy (Traefik routes these hostnames; no ui/api port is published on the host)
# ---------------------------------------------------------------------------

GYM_UI_HOST="gym.example.com"
GYM_API_HOST="gym-api.example.com"
# External docker network Traefik is attached to. Dokploy names it dokploy-network.
GYM_PROXY_NETWORK="dokploy-network"
# Traefik entrypoint: web (http, TLS ends in front of Traefik, e.g. Cloudflare) or websecure.
GYM_TRAEFIK_ENTRYPOINT="web"

# The database host port, for an SSH tunnel. Keep it on loopback.
GYM_DB_BIND="127.0.0.1"
GYM_DB_PORT="1433"

# ---------------------------------------------------------------------------
# Auth0
# ---------------------------------------------------------------------------

# Auth0 tenant domain, without https://.
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
# Identifier of the Auth0 API (access-token audience).
AUTH0_AUDIENCE="https://api.fitnessclub"
# Client ID of the Auth0 Single Page Application used by the UI. Baked into the UI at build time.
AUTH0_UI_CLIENT_ID="your-spa-client-id"
# Token claim that carries the user's roles (set by the Auth0 post-login action).
AUTH0_ROLES_CLAIM="https://fitnessclub/roles"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
# Don't use ";" because it ends the value inside the connection string.
DB_SA_PASSWORD="Change_Me_123!"
# Database name. The API creates and migrates it on startup.
DB_NAME="FitnessClub"
# SQL Server edition: Express (free, 10 GB per database), Standard, Enterprise or a product key.
# Developer is free but not licensed for production use.
MSSQL_PID="Express"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Club time zone (IANA name). Sets what "today" means for check-ins, memberships, reports,
# and the 08:00 daily expiry-notification job.
CLUB_TIME_ZONE="Europe/Kyiv"
# Production hides the OpenAPI document, Scalar and the Hangfire dashboard.
ASPNETCORE_ENVIRONMENT="Production"
# Log levels: Trace, Debug, Information, Warning, Error, Critical, None.
API_LOG_LEVEL="Information"
API_LOG_LEVEL_ASPNETCORE="Warning"
# Days before a membership ends to send the expiry notice (1-60).
EXPIRY_NOTICE_DAYS="7"

# ---------------------------------------------------------------------------
# Email (Twilio SendGrid)
# ---------------------------------------------------------------------------

# An API key with "Mail Send" access, and a from-address that is verified in SendGrid
# (Settings -> Sender Authentication).
SENDGRID_API_KEY="SG.your-api-key"
SENDGRID_FROM_ADDRESS="club@yourdomain.com"
SENDGRID_FROM_NAME="Fitness Club"
